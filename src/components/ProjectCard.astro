---
import { Image } from 'astro:assets';
import { cover, excerpt, type Entry } from '../data/content';

interface Props { entry: Entry; eager?: boolean; }
const { entry, eager = false } = Astro.props;
const img = cover(entry);
---

<article class="card reveal">
  <a href={`/realisations/${entry.slug}/`}>
    <div class="card__media">
      {img ? (
        <Image
          src={img}
          alt={entry.images[0].alt || entry.h1}
          widths={[420, 640, 900]}
          sizes="(max-width: 40rem) 92vw, (max-width: 70rem) 46vw, 30vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
      ) : (
        <div class="card__ph" aria-hidden="true"></div>
      )}
    </div>
    <h3 class="card__title">{entry.h1}</h3>
    <p class="card__text">{excerpt(entry, 120)}</p>
    <span class="card__cta">Voir le projet</span>
  </a>
</article>

<style>
  .card a { display: grid; text-decoration: none; color: inherit; }
  .card__media { overflow: hidden; background: var(--paper-2); aspect-ratio: 4 / 3; }
  .card__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.9s var(--ease), filter 0.6s var(--ease);
  }
  .card a:hover .card__media :global(img) { transform: scale(1.045); }
  .card__ph { width: 100%; height: 100%; background: var(--paper-2); }

  .card__title {
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem);
    margin: 1.25rem 0 0.5rem; line-height: 1.22;
  }
  .card__text { font-size: 0.9rem; color: var(--ink-mute); margin: 0 0 1rem; line-height: 1.62; }
  .card__cta {
    font-size: 0.7rem; font-weight: 560; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--brass); position: relative; padding-bottom: 0.3rem;
  }
  .card__cta::after {
    content: ''; position: absolute; left: 0; bottom: 0; height: 1px; width: 100%;
    background: var(--brass); transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .card a:hover .card__cta::after { transform: scaleX(1); }
</style>
