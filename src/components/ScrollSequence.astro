---
/**
 * Animation pilotée par le défilement : une séquence d'images est « scrubbée »
 * comme une pellicule, la position de la page servant de curseur temporel.
 * C'est la technique employée par Rolex ou Apple pour faire tourner un objet.
 *
 * Les images doivent être une orbite régulière autour du même sujet, cadrage
 * et éclairage constants. Ici : un rendu 3D exporté image par image.
 */
interface Props {
  /** Modèle du chemin, `%` remplacé par l'index sur 3 chiffres. */
  pattern: string;
  frames: number;
  eyebrow?: string;
  title: string;
  text?: string;
  /** Hauteur de défilement : plus c'est haut, plus la rotation est lente. */
  scroll?: string;
}
const { pattern, frames, eyebrow, title, text, scroll = '320svh' } = Astro.props;
const first = pattern.replace('%', '000');
---

<section class="seq" data-seq data-pattern={pattern} data-frames={frames} style={`--scroll:${scroll}`}>
  <!-- L'intitulé défile normalement : il ne doit pas repousser la maison vers
       le bas du panneau, qui la voulait au centre de l'écran. -->
  <div class="wrap seq__intro">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {text && <p class="seq__text">{text}</p>}
    <div class="seq__hint" data-hint aria-hidden="true">
      <span>Faites défiler pour faire tourner la maison</span>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"
        ><path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg
      >
    </div>
  </div>

  <div class="seq__track" data-track>
    <div class="seq__pin">
      <canvas class="seq__canvas" data-canvas aria-hidden="true"></canvas>

      <!-- Repli sans JavaScript et pour « animations réduites » : une image fixe. -->
      <noscript><img src={first} alt={title} class="seq__static" /></noscript>

      <!-- Position dans la rotation : rend le mécanisme lisible d'un coup d'œil. -->
      <div class="seq__progress" aria-hidden="true"><i data-progress></i></div>
    </div>
  </div>
</section>

<style>
  /* Le panneau épinglé est court : la maison tourne au centre de l'écran et
     la page reste visible autour. L'épinglage est bref, pour que la section
     suivante entre dans le champ pendant la fin de la rotation. */
  .seq {
    --panneau: 52svh;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    background: transparent;
  }
  @media (max-width: 52rem) { .seq { --panneau: 56svh; } }

  .seq__intro { text-align: center; max-width: min(44rem, 90vw); }
  .seq__intro h2 { margin: 0 0 0.6rem; }
  .seq__text { margin: 0 auto; color: var(--ink-soft); font-size: 1rem; max-width: 38rem; }
  .seq__intro .eyebrow { margin-bottom: 0.9rem; }

  .seq__track { height: var(--scroll); position: relative; }
  .seq__pin {
    position: sticky;
    top: calc((100svh - var(--panneau)) / 2);
    height: var(--panneau);
    overflow: hidden;
  }

  .seq__canvas, .seq__static {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain;
  }

  .seq__hint {
    display: flex; align-items: center; justify-content: center;
    gap: 0.5rem; margin-top: 1.6rem;
    font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--ink-mute); transition: opacity 0.5s var(--ease);
  }
  .seq__hint svg { animation: seq-bas 2.2s var(--ease) infinite; }
  .seq__hint[data-off] { opacity: 0; }
  @keyframes seq-bas {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }
  @media (prefers-reduced-motion: reduce) { .seq__hint svg { animation: none; } }
  @media (max-width: 34rem) { .seq__hint span { display: none; } }

  .seq__progress {
    position: absolute; inset: auto 0 0 0; height: 2px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .seq__progress i {
    display: block; height: 100%; width: 0;
    background: var(--brass); transition: width 0.12s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .seq__track { height: auto; }
    .seq__pin { position: static; height: auto; }
    .seq__canvas { position: static; height: min(52svh, 26rem); margin-top: 2rem; }
    .seq__hint, .seq__progress { display: none; }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-seq]').forEach((section) => {
    const canvas = section.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const hint = section.querySelector<HTMLElement>('[data-hint]');
    const track = section.querySelector<HTMLElement>('[data-track]')!;
    const panneau = section.querySelector<HTMLElement>('.seq__pin')!;
    const progress = section.querySelector<HTMLElement>('[data-progress]');
    const ctx = canvas.getContext('2d', { alpha: false })!;
    const pattern = section.dataset.pattern!;
    const total = Number(section.dataset.frames);

    const images: HTMLImageElement[] = [];
    let loaded = 0;
    let current = -1;
    let pending = false;

    const src = (i: number) => pattern.replace('%', String(i).padStart(3, '0'));

    const draw = (i: number) => {
      const img = images[i];
      if (!img?.complete || !img.naturalWidth) return;
      current = i;

      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = canvas.clientWidth * dpr;
      const h = canvas.clientHeight * dpr;
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }

      // Le panneau est transparent : la maison se détache sur le fond de page.
      ctx.fillStyle = getComputedStyle(document.body).backgroundColor || '#fbfaf7';
      ctx.fillRect(0, 0, w, h);

      // L'intitulé est hors du panneau : la maison est centrée, sans décalage.
      const marge = innerWidth >= 832 ? 0.88 : 0.98;
      const scale = Math.min((w * marge) / img.naturalWidth, (h * 0.9) / img.naturalHeight);
      const dw = img.naturalWidth * scale;
      const dh = img.naturalHeight * scale;
      ctx.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
    };

    const frameFromScroll = () => {
      const rect = track.getBoundingClientRect();
      const span = rect.height - panneau.offsetHeight;
      const debut = (innerHeight - panneau.offsetHeight) / 2;
      const p = span > 0 ? Math.min(Math.max((debut - rect.top) / span, 0), 1) : 0;
      hint?.toggleAttribute('data-off', p > 0.12);
      if (progress) progress.style.width = `${(p * 100).toFixed(1)}%`;
      return Math.min(total - 1, Math.round(p * (total - 1)));
    };

    const update = () => {
      pending = false;
      const i = frameFromScroll();
      if (i !== current) draw(i);
    };

    const onScroll = () => {
      if (pending) return;
      pending = true;
      requestAnimationFrame(update);
    };

    /**
     * La séquence pèse quelques centaines de kilo-octets : sur une page
     * d'accueil, la charger d'emblée la ralentirait pour tout le monde, y
     * compris ceux qui n'iront jamais jusqu'à cette section. On attend donc
     * qu'elle approche de l'écran.
     */
    let demarre = false;
    const charger = () => {
      if (demarre) return;
      demarre = true;

      // Placée haut dans la page, la séquence entrerait en concurrence avec la
      // grande photo d'accueil. On la laisse passer d'abord.
      if (document.readyState !== 'complete') {
        addEventListener('load', lancer, { once: true });
      } else {
        lancer();
      }
    };

    function lancer() {
      for (let i = 0; i < total; i++) {
        const img = new Image();
        img.decoding = 'async';
        img.src = src(i);
        img.onload = () => {
          loaded++;
          if (i === 0 || loaded === total) update();
        };
        images.push(img);
      }

      if (reduced) return;
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', () => { current = -1; update(); }, { passive: true });
    }

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            charger();
          }
        },
        // Une hauteur d'écran d'avance : les images sont prêtes à l'arrivée.
        { rootMargin: '100% 0px' }
      );
      io.observe(track);
    } else {
      charger();
    }
  });
</script>
