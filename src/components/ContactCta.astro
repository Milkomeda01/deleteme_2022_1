---
import { site } from '../data/site';

interface Props { title?: string; text?: string; subject?: string; }
const {
  title = 'Parlons de votre projet',
  text = "Premier échange sans engagement. Décrivez votre terrain, votre programme et votre budget : nous vous rappelons pour évaluer la faisabilité.",
  subject,
} = Astro.props;
const href = subject ? `/contact/?sujet=${encodeURIComponent(subject)}` : '/contact/';
---

<section class="cta">
  <div class="wrap cta__inner">
    <div>
      <p class="eyebrow">Denis Cartier Architecte DPLG</p>
      <h2>{title}</h2>
      <p class="cta__text">{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--light" href={href}>Demander une étude</a>
      <a class="cta__tel" href={`tel:${site.phoneHref}`}>
        <span>Ou appelez directement</span>
        <strong>{site.phone}</strong>
      </a>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--ink); color: var(--paper); padding-block: clamp(3.5rem, 7vw, 6.5rem); }
  .cta__inner {
    display: grid; gap: clamp(2rem, 4vw, 4rem);
    grid-template-columns: 1.35fr 1fr; align-items: center;
  }
  @media (max-width: 56rem) { .cta__inner { grid-template-columns: 1fr; } }
  .cta h2 { color: var(--paper); margin-bottom: 0.6rem; }
  .cta .eyebrow { color: var(--brass-soft); }
  .cta__text { color: color-mix(in srgb, var(--paper) 72%, transparent); max-width: 34rem; margin: 0; }
  .cta__actions { display: grid; gap: 1.75rem; justify-items: start; }
  @media (min-width: 56rem) { .cta__actions { justify-items: end; text-align: right; } }
  .cta__tel { text-decoration: none; display: grid; gap: 0.25rem; }
  .cta__tel span { font-size: 0.68rem; letter-spacing: 0.19em; text-transform: uppercase; color: var(--brass-soft); }
  .cta__tel strong { font-family: var(--font-display); font-size: 1.9rem; font-weight: 400; }
</style>
